# Shared MCP Server settings. Variable names and safe defaults only; never put secrets here.
# MCP_SERVER_HOST must be a loopback address until deployment hardening (Step 8).
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8100
MCP_SERVER_PATH=/mcp
# Must be an initialize-handshake version supported by the installed SDK.
MCP_PROTOCOL_VERSION=2025-11-25
MCP_MAX_REQUEST_BODY_BYTES=262144
MCP_LOG_LEVEL=INFO

# --- Step 3 authentication ---
# App registrations (token SHA-256 hashes + Ed25519 public keys; see config/apps.example.json).
# Keep the real file under secrets/ (git-ignored). Unset => no apps => every /mcp request is 401.
# MCP_APPS_FILE=secrets/apps.json
MCP_ASSERTION_AUDIENCE=shared-mcp-server
# Approved limits: lifetime <= 60 s, clock skew <= 5 s (larger values are refused at startup).
MCP_ASSERTION_MAX_LIFETIME_SECONDS=60
MCP_CLOCK_SKEW_SECONDS=5
# In-memory replay cache: valid for a single worker process only (see README).
MCP_REPLAY_CACHE_MAX_ENTRIES=50000
