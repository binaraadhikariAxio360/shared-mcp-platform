# Shared MCP Server settings (Step 2). Variable names and safe defaults only; no secrets exist yet.
# MCP_SERVER_HOST must be a loopback address until authentication is implemented.
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8100
MCP_SERVER_PATH=/mcp
# Must be an initialize-handshake version supported by the installed SDK.
MCP_PROTOCOL_VERSION=2025-11-25
MCP_MAX_REQUEST_BODY_BYTES=262144
MCP_LOG_LEVEL=INFO
